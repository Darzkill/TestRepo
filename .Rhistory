library(downloader)
library(readxl)
library(xlsx)
# Directorio de descarga
directorio_descarga <- "C:/Users/USER/Downloads/Siniestros sobres primas netas (R. Siniestralidad)/Boletines SBS"
# Enlaces a los archivos ZIP
enlaces_zip <- c(
"https://intranet2.sbs.gob.pe/estadistica/financiera/2017/Marzo/S-367-ma2017.ZIP",
"https://intranet2.sbs.gob.pe/estadistica/financiera/2017/Junio/S-367-jn2017.ZIP",
"https://intranet2.sbs.gob.pe/estadistica/financiera/2017/Setiembre/S-367-se2017.ZIP",
"https://intranet2.sbs.gob.pe/estadistica/financiera/2017/Diciembre/S-367-di2017.ZIP"
)
# Crear la carpeta de descarga si no existe
if (!dir.exists(directorio_descarga)) {
dir.create(directorio_descarga, recursive = TRUE)
}
# Descargar archivos ZIP
for (enlace in enlaces_zip) {
# Nombre del archivo ZIP
nombre_zip <- basename(enlace)
# Ruta completa del archivo ZIP
ruta_zip <- file.path(directorio_descarga, nombre_zip)
# Descargar el archivo ZIP
tryCatch({
download.file(enlace, destfile = ruta_zip, mode = "wb")
cat("Archivo descargado:", ruta_zip, "\n")
}, error = function(e) {
cat("Error al descargar el archivo:", enlace, "\n")
})
}
# Mensaje de finalización
cat("Descarga completada.\n")
